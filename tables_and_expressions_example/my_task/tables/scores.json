{
  "columns": {
    "round": {"type": "integer", "default": 0},
    "score": {"type": "integer", "default": 0}
  },
  "exports": [
    {
      "fields": {
        "high_score":  "max(score)",
        "mean_score":  "avg(score)",
        "total_score": "sum(score)"
      }
    },
    {
      "group_by": "round",
      "fields": {
        "round_score": "max(score)"
      }
    }
  ]
}
